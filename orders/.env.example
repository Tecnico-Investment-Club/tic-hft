# HFT Orders - Environment Variables Template
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then edit .env with your real credentials.
# NEVER commit .env file!

# Alpaca API Key (Required)
# Get from: https://app.alpaca.markets/
ALPACA_API_KEY="PKxxxxx..."

# Alpaca Secret Key (Required)
# Get from: https://app.alpaca.markets/
ALPACA_SECRET_KEY="xxxxxxxxxxxxxxxx"

# Alpaca Base URL (Required)
# Paper: https://paper-api.alpaca.markets  (testing)
# Live:  https://api.alpaca.markets        (real money)
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
