# ============================================
# HFT Paper Engine Orders - Environment Config
# ============================================
#
# INSTRUÇÕES:
# 1. Copiar este ficheiro: cp .env.example .env
# 2. Preenchê-lo com as tuas variáveis reais
# 3. NÃO commitar .env (está em .gitignore)
# 4. Usar: export $(cat .env | xargs) ou source .env
#
# ============================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Formato: postgresql://user:password@host:port/database

# Conexão para ler dados do ETL
DB_SOURCE_CONNECTION=postgresql://hft_user:hft_password@localhost:5432/hft_db

# Conexão para escrever ordens
DB_TARGET_CONNECTION=postgresql://hft_user:hft_password@localhost:5432/hft_db

# ============================================================================
# ALPACA API CONFIGURATION
# ============================================================================

# Token da Alpaca (https://app.alpaca.markets/signup)
# Obter em: Account Settings → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here

# Base URL da Alpaca
# Paper Trading: https://paper-api.alpaca.markets
# Live Trading:  https://api.alpaca.markets (USE COM CUIDADO!)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================================================
# STRATEGY CONFIGURATION
# ============================================================================

# ID único do portfólio (INT)
PORTFOLIO_ID=1

# ID da estratégia (INT)
STRATEGY_ID=1

# Alocação de capital (USD)
CASH_ALLOCATION=1000.0

# ============================================================================
# RUNTIME CONFIGURATION
# ============================================================================

# Modo de teste (não executa ordens reais)
# true = não executa ordens no broker
# false = executa ordens reais (USE COM CUIDADO!)
DRY_RUN=true

# Nível de log (opcional)
# LOG_LEVEL=INFO
# Possíveis: DEBUG, INFO, WARNING, ERROR

# ============================================================================
# DOCKER CONFIGURATION (se usar docker-compose)
# ============================================================================

# Credenciais PostgreSQL (docker-compose)
POSTGRES_USER=hft_user
POSTGRES_PASSWORD=hft_password
POSTGRES_DB=hft_db

# ============================================================================
# SEGURANÇA - BOAS PRÁTICAS
# ============================================================================
#
# ✓ FAZER:
#   - Guardar .env em local seguro e privado
#   - Usar credentials manager (1Password, LastPass, etc)
#   - Rotar tokens Alpaca regularmente
#   - Never commit .env ao git
#   - Usar permissões restritivas: chmod 600 .env
#
# ✗ NÃO FAZER:
#   - Hardcode secrets no código
#   - Commitar .env ao git
#   - Compartilhar .env por email/chat
#   - Usar as mesmas credentials em dev/prod
#   - Guardar passwords em plain text em repositórios
#
# ============================================================================
